// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// Internal display
output "BOE NE135A1M-NY1 Unknown" {
  mode "2880x1920@120.000"
  variable-refresh-rate
  scale 2

  layout {
    preset-column-widths {
      proportion 0.5
      proportion 1.0
    }

    default-column-width { proportion 1.0; }
  }
}

// external Asus 5K display
output "ASUSTek COMPUTER INC XG27JCG TBLMQS083924" {
  mode "5120x2880@119.994"
  variable-refresh-rate
  scale 2
  focus-at-startup

  layout {
    preset-column-widths {
      proportion 0.25
      proportion 0.5
      proportion 0.75
      proportion 1.0
    }

    default-column-width { proportion 0.75; }
  }
}
