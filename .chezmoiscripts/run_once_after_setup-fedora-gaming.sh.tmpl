{{ if and (eq .osid "linux-fedora") (not .headless) (get . "gaming") -}}
#!/usr/bin/env bash
set -eo pipefail

packages=(
  steam                    # RPM Fusion nonfree, pulls 32-bit Mesa + steam-devices
  mesa-vulkan-drivers.i686 # 32-bit Vulkan for older Proton games
  mangohud.x86_64          # FPS/frametime overlay
  mangohud.i686            # overlay for 32-bit games
  gamescope                # micro-compositor: upscaling, HDR, frame limiting
)

flatpaks=(
  com.vysp3r.ProtonPlus # GE-Proton and other Proton builds
)

echo "Installing gaming packages..."
sudo dnf install -y "${packages[@]}"

echo "Installing gaming flatpaks..."
flatpak install -y --noninteractive flathub "${flatpaks[@]}"

# Gaming mode: a login-screen session that boots straight into Steam Big Picture
# inside gamescope (~/.local/bin/steam-gamescope-session). GDM only reads
# sessions from system dirs, hence sudo.
echo "Installing Steam gaming mode session..."
sudo mkdir -p /usr/local/share/wayland-sessions
sudo tee /usr/local/share/wayland-sessions/steam-gamescope.desktop >/dev/null <<'EOF'
[Desktop Entry]
Name=Steam (Gaming Mode)
Comment=Steam Big Picture in gamescope
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-gamescope-session
Type=Application
DesktopNames=gamescope
EOF
{{ end -}}
