#!/usr/bin/env bash

# Source global definitions
if [ -f /etc/bashrc ]; then
  . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
  PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# if homebrew is installed (likely on macos) load its shellenv to be able to start fish
if test -f /opt/homebrew/bin/brew; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif test -f /home/linuxbrew/.linuxbrew/bin/brew; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# start fish if not the parent process, is first shell level and is not 'dumb' terminal
if ps -o comm -p $PPID | grep -qv fish && [[ "${SHLVL}" == "1" ]] && [[ "${TERM}" != "dumb" ]]; then
  exec fish
fi
